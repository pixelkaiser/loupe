{
  "harness": "whip",
  "model": "glm-5.3",
  "timezone": "CET",
  "maxTurns": 5,
  "whip": {
    "provider": {
      "name": "zai",
      "label": "Z.ai",
      "baseUrl": "https://api.z.ai/api/paas/v4",
      "apiKeyEnv": "ZAI_API_KEY"
    },
    "defaultModel": "glm-5.3",
    "models": ["glm-5.3"]
  },
  "reviewers": [
    {
      "name": "code",
      "promptFile": "reviewers/code.md",
      "include": ["packages/**/*.ts", "action.yml"],
      "exclude": ["**/*.test.ts", "**/tests/**", "**/dist/**"],
      "reasoning": "medium"
    }
  ]
}
